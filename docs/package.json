{
	"name": "@skygenesisenterprise/react-sds-docs",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "next dev --port 3000",
		"build": "next build",
		"start": "next start --port 3000",
		"postinstall": "fumadocs-mdx",
		"types:check": "fumadocs-mdx && tsc --noEmit -p tsconfig.typecheck.json",
		"generate": "node scripts/generate-api.mjs",
		"generate:check": "node scripts/generate-api.mjs --check",
		"check": "node scripts/check-docs.mjs"
	},
	"dependencies": {
		"@skygenesisenterprise/react-sds": "workspace:*",
		"fumadocs-core": "16.17.5",
		"fumadocs-mdx": "14.1.0",
		"fumadocs-ui": "16.17.5",
		"next": "16.3.3",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@types/mdx": "^2.0.13",
		"@types/node": "^24.10.0",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"typescript": "^5.9.3"
	}
}
